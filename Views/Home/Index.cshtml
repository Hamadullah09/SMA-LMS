@using System.Globalization
@model Library_Management_system.Models.HomeViewModel
@inject Microsoft.Extensions.Options.IOptions<Library_Management_system.Application.Policies.LibraryHoursOptions> LibraryHours
@{
    ViewData["Title"] = "Home";
    ViewData["FullWidth"] = true;   // opt out of the 960px container
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}

@*
    SMA LMS homepage.

    Rebuilt on the SMA design system. Every behaviour of the inherited page is preserved —
    category links, book detail links, favourite add/remove (antiforgery intact) and the share
    buttons that site.js binds to `.share-book-btn` via its data- attributes.

    The substantive addition is availability on every book card: "can I actually borrow this?"
    is the first question a student has, and the previous homepage never answered it.
*@

<div id="homePage" class="sma-home">

    <!-- ============================ Hero ============================ -->
    @*
        Search lives in the bar, once, on every page. The box that used to sit here made two
        search fields on one screen and only worked while the hero was in view.

        What replaces it is what a student cannot get from the bar: whether the library is open
        right now, and how much of the catalogue is actually on the shelf at this moment. Real
        figures, read per request — see HomeController.Index.
    *@
    <section class="sma-hero" aria-labelledby="smaHeroTitle">
        <div class="sma-hero__body">
            <h1 class="sma-hero__title" id="smaHeroTitle">Find it, borrow it, get back to studying.</h1>
            <p class="sma-hero__lead">
                Search the catalogue from the bar above, see exactly which shelf a book is on, and
                check it out yourself at the self-service station.
            </p>

            @{
                var hours = LibraryHours.Value;
                // Library time, not server time: the host runs on UTC, which reported the
                // library closed at 05:50 UTC while it was 10:50 and open in Karachi.
                var libraryNow = hours.LocalNow();
                var openNow = hours.IsOpenAt(libraryNow);
                var todayIsWeekend = libraryNow.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                var todayRange = todayIsWeekend ? hours.WeekendRange : hours.WeekdayRange;
            }

            @* Status carries a word as well as a colour (specification section 111). *@
            <p class="sma-hero__status @(openNow ? "is-open" : "is-closed")">
                <span class="sma-hero__status-dot" aria-hidden="true"></span>
                <strong>@(openNow ? "Open now" : "Closed")</strong>
                <span class="sma-hero__status-detail">Today @todayRange</span>
            </p>

            <dl class="sma-hero__figures">
                <div>
                    <dt>Titles</dt>
                    <dd>@Model.TitleCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
                </div>
                <div>
                    <dt>On the shelf now</dt>
                    <dd>@Model.AvailableNowCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
                </div>
                <div>
                    <dt>Subjects</dt>
                    <dd>@Model.SubjectCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
                </div>
            </dl>

            <div class="sma-hero__actions">
                @if (isSignedIn)
                {
                    <a class="is-primary" href="/kiosk">Check out a book</a>
                    <a href="/portal">My library</a>
                }
                else
                {
                    <a class="is-primary" asp-area="Identity" asp-page="/Account/Login">Sign in to borrow</a>
                    <a asp-controller="Home" asp-action="Category">Browse by subject</a>
                }
            </div>
        </div>
    </section>

    <!-- ======================= Quick actions ======================== -->
    @* Section 8 wants the common actions obvious rather than buried in a menu. *@
    <section class="sma-quick" aria-label="Quick actions">
        <a class="sma-quick__item" asp-controller="Home" asp-action="Book">
            <span class="sma-quick__icon" aria-hidden="true">▤</span>
            <span class="sma-quick__label">Browse books</span>
            <span class="sma-quick__hint">The full catalogue</span>
        </a>
        <a class="sma-quick__item" href="/portal">
            <span class="sma-quick__icon" aria-hidden="true">◫</span>
            <span class="sma-quick__label">My books</span>
            <span class="sma-quick__hint">What you have out</span>
        </a>
        <a class="sma-quick__item" href="/portal">
            <span class="sma-quick__icon" aria-hidden="true">◷</span>
            <span class="sma-quick__label">Due dates &amp; fines</span>
            <span class="sma-quick__hint">What you owe, if anything</span>
        </a>
    </section>

    <!-- ======================== Categories ========================== -->
    <section class="sma-home-section" aria-labelledby="catsTitle">
        <div class="sma-home-section__head">
            <div>
                <h2 class="sma-home-section__title" id="catsTitle">Browse by subject</h2>
                <p class="sma-home-section__sub">Jump straight to the shelf you need.</p>
            </div>
            <a class="sma-home-link" asp-controller="Home" asp-action="Book">All categories →</a>
        </div>

        @if (!Model.Categories.Any())
        {
            <div class="sma-home-empty">
                <p><strong>No categories yet.</strong></p>
                <p>Once a librarian adds books, subjects appear here for browsing.</p>
            </div>
        }
        else
        {
            <div class="sma-cat-grid">
                @foreach (var category in Model.Categories)
                {
                    var img = string.IsNullOrWhiteSpace(category.ImageUrl)
                        ? "/images/User/Book/general.jpg"
                        : category.ImageUrl;

                    <a class="sma-cat" asp-controller="Home" asp-action="Book" asp-route-category="@category.Name">
                        <span class="sma-cat__media">
                            <img src="@img" alt="" aria-hidden="true" loading="lazy" />
                        </span>
                        <span class="sma-cat__name">@category.Name</span>
                    </a>
                }
            </div>
        }
    </section>

    <!-- ========================= Trending =========================== -->
    <section class="sma-home-section" aria-labelledby="trendTitle">
        <div class="sma-home-section__head">
            <div>
                <h2 class="sma-home-section__title" id="trendTitle">Popular right now</h2>
                <p class="sma-home-section__sub">What other students are borrowing.</p>
            </div>
            <a class="sma-home-link" asp-controller="Home" asp-action="Book">See all →</a>
        </div>

        @if (!Model.TrendingBooks.Any())
        {
            <div class="sma-home-empty">
                <p><strong>The catalogue is empty.</strong></p>
                <p>Books added by a librarian will appear here.</p>
            </div>
        }
        else
        {
            <div class="sma-book-rail custom-scrollbar">
                @foreach (var book in Model.TrendingBooks)
                {
                    @await Html.PartialAsync("_SmaBookCard", (book, Model, returnUrl))
                }
            </div>
        }
    </section>

    <!-- ======================= New arrivals ========================= -->
    <section class="sma-home-section" aria-labelledby="newTitle">
        <div class="sma-home-section__head">
            <div>
                <h2 class="sma-home-section__title" id="newTitle">Just added</h2>
                <p class="sma-home-section__sub">The newest titles on the shelves.</p>
            </div>
            <a class="sma-home-link" asp-controller="Home" asp-action="Book">See all →</a>
        </div>

        @if (!Model.NewArrivalBooks.Any())
        {
            <div class="sma-home-empty">
                <p><strong>Nothing new yet.</strong></p>
                <p>Recently added books will show up here.</p>
            </div>
        }
        else
        {
            <div class="sma-book-grid">
                @foreach (var book in Model.NewArrivalBooks)
                {
                    @await Html.PartialAsync("_SmaBookCard", (book, Model, returnUrl))
                }
            </div>
        }
    </section>

    <!-- ====================== Using the library ===================== -->
    <section class="sma-info" aria-labelledby="infoTitle">
        <h2 class="sma-info__title" id="infoTitle">Using the library</h2>
        <div class="sma-info__grid">
            <div class="sma-info__item">
                <h3>Opening hours</h3>
                @* One source for the hours, shared with the About page and the assistant. *@
                <p>
                    Monday – Friday, @LibraryHours.Value.WeekdayRange<br />
                    Saturday – Sunday, @LibraryHours.Value.WeekendRange
                </p>
            </div>
            <div class="sma-info__item">
                <h3>Borrowing</h3>
                <p>Bring the book and your student card to the circulation desk. Scan both and you're done.</p>
            </div>
            <div class="sma-info__item">
                <h3>Can't find something?</h3>
                <p>The <a href="/assistant">library assistant</a> can tell you whether we hold a title and which shelf it's on.</p>
            </div>
            <div class="sma-info__item">
                <h3>Need help?</h3>
                <p>Ask at the circulation desk, or see the <a asp-controller="About" asp-action="Support">support page</a>.</p>
            </div>
        </div>
    </section>
</div>

@await Html.PartialAsync("_StaticChatbot")

