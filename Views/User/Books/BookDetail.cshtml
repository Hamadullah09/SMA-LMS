@using System.Globalization
@using Library_Management_system.Models
@model Library_Management_system.Models.BookDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["FullWidth"] = true;   // the design system supplies its own measure

    var book = Model.Book;
    ViewData["Title"] = string.IsNullOrWhiteSpace(book.Title) ? "Book detail" : book.Title;
    ViewData["BreadcrumbCurrent"] = string.IsNullOrWhiteSpace(book.Title) ? "Book detail" : book.Title;

    var imagePath = string.IsNullOrWhiteSpace(book.ImageUrl)
        ? Url.Content("~/images/User/Book/book2.png")
        : Url.Content(book.ImageUrl);
    var rating = Math.Clamp(book.Rating, 0, 5);
    var publishYear = book.Year > 0
        ? book.Year.ToString(CultureInfo.InvariantCulture)
        : book.CreatedDate?.Year.ToString(CultureInfo.InvariantCulture) ?? "—";
    var totalPages = book.Pages > 0 ? book.Pages.ToString(CultureInfo.InvariantCulture) : "—";
    var bookCode = string.IsNullOrWhiteSpace(book.BookCode) ? $"A{book.Id:0000}" : book.BookCode;
    var category = string.IsNullOrWhiteSpace(book.CategoryName) ? "General" : book.CategoryName;
    var description = string.IsNullOrWhiteSpace(book.Description)
        ? "No summary is available for this book yet."
        : book.Description;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var shareUrl = Url.Action("BookDetail", "Home", new { id = book.Id }) ?? $"/book/{book.Id}";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}

@*
    Book detail.

    Rebuilt on the student design system. Two substantive changes beyond styling:

    * availability is now the headline fact. This page decides whether a student walks to a
      shelf, and it previously answered with a star rating, a page count and a book code —
      everything except whether the book could be borrowed.

    * the related strip carried a third copy of the book-card markup. It renders _SmaBookCard
      now, like the homepage and browse, so the three cannot drift apart again.

    Behaviour preserved exactly: the add-to-cart form, both favourite forms with their
    antiforgery tokens and returnUrl, the share button's class and data- attributes that the
    script at the bottom binds to, and the review modal.
*@

<div class="sma-detail">

    <div class="sma-detail__main">

        @* ---------------- cover ---------------- *@
        <div class="sma-detail__media">
            <img class="sma-detail__cover" src="@imagePath" alt="Cover of @book.Title" />
        </div>

        @* ---------------- information ---------------- *@
        <div class="sma-detail__info">

            <p class="sma-detail__cat">@category</p>
            <h1 class="sma-detail__title">@book.Title</h1>
            <p class="sma-detail__author">@book.Author</p>

            <div class="sma-detail__rating" role="img" aria-label="Rated @rating out of 5">
                @for (var i = 0; i < 5; i++)
                {
                    <span class="sma-detail__star @(i < rating ? "is-on" : "")" aria-hidden="true">★</span>
                }
                <span class="sma-detail__rating-text">@rating / 5</span>
            </div>

            @* The one thing a student actually needs. Glyph plus colour, never colour alone. *@
            <div class="sma-detail__availability @(Model.IsBorrowable ? "is-ok" : "is-out")">
                <span class="sma-detail__availability-glyph" aria-hidden="true">@(Model.IsBorrowable ? "✓" : "●")</span>
                <div>
                    <strong>@Model.AvailabilityText</strong>
                    @if (Model.TotalCopies > 0)
                    {
                        <span class="sma-detail__availability-sub">
                            of @Model.TotalCopies cop@(Model.TotalCopies == 1 ? "y" : "ies") held by the library
                        </span>
                    }
                    else
                    {
                        <span class="sma-detail__availability-sub">
                            Ask at the desk — no copies of this title are on the shelf yet.
                        </span>
                    }
                </div>
            </div>

            @if (TempData["BookReviewSuccess"] is string reviewSuccess && !string.IsNullOrWhiteSpace(reviewSuccess))
            {
                <div class="sma-detail__flash is-ok" role="status">@reviewSuccess</div>
            }
            @if (TempData["BookReviewError"] is string reviewError && !string.IsNullOrWhiteSpace(reviewError))
            {
                <div class="sma-detail__flash is-bad" role="alert">@reviewError</div>
            }

            @* ---------------- actions ---------------- *@
            <div class="sma-detail__actions">
                @if (isSignedIn)
                {
                    <form method="post" asp-controller="Home" asp-action="AddToCart" asp-route-bookId="@book.Id"
                          class="cart-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sma-detail__cart">
                            <i class="bi bi-cart2" aria-hidden="true"></i> Add to cart
                        </button>
                    </form>
                }
                else
                {
                    <a class="sma-detail__cart" asp-area="Identity" asp-page="/Account/Login"
                       asp-route-returnUrl="@returnUrl">
                        <i class="bi bi-cart2" aria-hidden="true"></i> Sign in to borrow
                    </a>
                }

                @if (Model.IsFavorite)
                {
                    <form method="post" asp-controller="Home" asp-action="RemoveFavorite" asp-route-bookId="@book.Id"
                          class="fav-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn-fav-circle sma-detail__circle is-active"
                                aria-label="Remove from saved books" title="Remove from saved">
                            <i class="bi bi-heart-fill" aria-hidden="true"></i>
                        </button>
                    </form>
                }
                else
                {
                    <form method="post" asp-controller="Home" asp-action="AddFavorite" asp-route-bookId="@book.Id"
                          class="fav-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn-fav-circle sma-detail__circle"
                                aria-label="Save for later" title="Save for later">
                            <i class="bi bi-heart" aria-hidden="true"></i>
                        </button>
                    </form>
                }

                @* Class and data- attributes kept exactly: the script at the bottom binds to them. *@
                <button type="button"
                        class="btn-share-circle sma-detail__circle"
                        data-share-url="@shareUrl"
                        data-share-title="@book.Title"
                        data-share-author="@book.Author"
                        title="Share"
                        aria-label="Share @book.Title">
                    <i class="bi bi-share" aria-hidden="true"></i>
                </button>

                @if (isSignedIn)
                {
                    <button type="button" class="sma-detail__review-open"
                            data-bs-toggle="modal" data-bs-target="#bookFeedbackModal">
                        Write a review
                    </button>
                }
            </div>

            @* ---------------- facts ---------------- *@
            <dl class="sma-detail__facts">
                <div><dt>Book code</dt><dd class="sma-mono">@bookCode</dd></div>
                <div><dt>Subject</dt><dd>@category</dd></div>
                <div><dt>Published</dt><dd>@publishYear</dd></div>
                <div><dt>Pages</dt><dd>@totalPages</dd></div>
                @if (!string.IsNullOrWhiteSpace(book.Isbn))
                {
                    <div><dt>ISBN</dt><dd class="sma-mono">@book.Isbn</dd></div>
                }
            </dl>

            <section class="sma-detail__about" aria-labelledby="aboutHeading">
                <h2 class="sma-detail__section-title" id="aboutHeading">About this book</h2>
                <p class="sma-detail__desc">@description</p>
            </section>
        </div>
    </div>

    @* ---------------- related ---------------- *@
    <section class="sma-detail__related" aria-labelledby="relatedHeading">
        <div class="sma-home-section__head">
            <h2 class="sma-home-section__title" id="relatedHeading">You might also like</h2>
            <a class="sma-home-link" asp-controller="Home" asp-action="Book"
               asp-route-category="@book.CategoryName">More in @category</a>
        </div>

        @if (Model.RelatedBooks != null && Model.RelatedBooks.Any())
        {
            <div class="sma-book-grid">
                @foreach (var relatedBook in Model.RelatedBooks)
                {
                    <partial name="_SmaBookCard" model="@((relatedBook, Model.RelatedCards, returnUrl))" />
                }
            </div>
        }
        else
        {
            <div class="sma-home-empty">No related books found.</div>
        }
    </section>
</div>

@if (isSignedIn)
{
    <div class="modal fade" id="bookFeedbackModal" tabindex="-1" aria-labelledby="bookFeedbackModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content review-modal">
                <div class="modal-body p-4 p-md-5">
                    <h2 class="review-title" id="bookFeedbackModalLabel">Your Feedback</h2>
                    <p class="review-subtitle">Please rate the quality of the book you received.</p>

                    <form method="post" asp-controller="Home" asp-action="SubmitBookReview">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@book.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="rating" id="selectedRatingInput" value="5" />

                        <div class="review-stars" id="feedbackStars" role="group" aria-label="Book rating">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <button type="button" class="star-btn active" data-rating="@i" aria-label="Rate @i star(s)">
                                    <i class="bi bi-star-fill"></i>
                                </button>
                            }
                        </div>

                        <div class="review-bottom">
                            <div class="review-user">
                                <span class="review-avatar">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                                <span>@(User.Identity?.Name ?? "User")</span>
                            </div>
                            <button type="submit" class="btn-submit-review">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        (function () {
            const starsWrap = document.getElementById('feedbackStars');
            const ratingInput = document.getElementById('selectedRatingInput');
            if (starsWrap && ratingInput) {
                const starButtons = Array.from(starsWrap.querySelectorAll('.star-btn'));

                const paintStars = (rating) => {
                    starButtons.forEach((btn) => {
                        const value = Number(btn.dataset.rating || 0);
                        btn.classList.toggle('active', value <= rating);
                    });
                };

                starButtons.forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const rating = Number(btn.dataset.rating || 5);
                        ratingInput.value = String(rating);
                        paintStars(rating);
                    });
                });

                paintStars(Number(ratingInput.value || 5));
            }

            const shareButton = document.querySelector('.btn-share-circle');
            if (!shareButton) return;

            const toAbsoluteUrl = (url) => {
                try {
                    return new URL(url, window.location.origin).href;
                } catch {
                    return window.location.href;
                }
            };

            const flashShareState = (titleText) => {
                const currentTitle = shareButton.getAttribute('title') || 'Share';
                shareButton.setAttribute('title', titleText);

                window.setTimeout(() => {
                    shareButton.setAttribute('title', currentTitle);
                }, 1400);
            };

            const copyToClipboard = async (text) => {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    return true;
                }

                const helper = document.createElement('textarea');
                helper.value = text;
                helper.setAttribute('readonly', '');
                helper.style.position = 'fixed';
                helper.style.opacity = '0';
                document.body.appendChild(helper);
                helper.select();

                const copied = document.execCommand('copy');
                document.body.removeChild(helper);
                return copied;
            };

            shareButton.addEventListener('click', async () => {
                const shareTargetUrl = toAbsoluteUrl(shareButton.dataset.shareUrl || window.location.href);
                const shareTitle = shareButton.dataset.shareTitle || document.title;
                const shareAuthor = shareButton.dataset.shareAuthor;
                const shareText = shareAuthor ? `${shareTitle} by ${shareAuthor}` : shareTitle;

                try {
                    if (typeof navigator.share === 'function') {
                        await navigator.share({
                            title: shareTitle,
                            text: shareText,
                            url: shareTargetUrl
                        });
                        flashShareState('Shared');
                        return;
                    }

                    const copied = await copyToClipboard(shareTargetUrl);
                    flashShareState(copied ? 'Link copied' : 'Copy failed');
                } catch (error) {
                    if (error && typeof error === 'object' && 'name' in error && error.name === 'AbortError') {
                        return;
                    }

                    try {
                        const copied = await copyToClipboard(shareTargetUrl);
                        flashShareState(copied ? 'Link copied' : 'Copy failed');
                    } catch {
                        flashShareState('Copy failed');
                    }
                }
            });
        })();
    </script>
}
