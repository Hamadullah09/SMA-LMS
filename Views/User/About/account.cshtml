@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Account & Settings";
}

<!DOCTYPE html>
<html>

<head>
    <title>Account & Settings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/users/accounts.css" asp-append-version="true" />
</head>

<body>
    <div class="wrapper">

        <div class="header">
            <h1>Account & Settings</h1>
            <p>Manage your library account and access</p>
        </div>

        <div class="container">

            <!-- Sidebar -->
            <aside class="sidebar">
                <a class="nav-button @(ViewContext.HttpContext.Request.Path == "/about/faq" ? "active" : "")"
                   asp-controller="Home" asp-action="AboutFaq">
                    <i class="bi bi-grid-3x3-gap nav-icon" aria-hidden="true"></i>
                    <span class="nav-label">General</span>
                </a>

                <a class="nav-button @(ViewContext.HttpContext.Request.Path == "/about/account" ? "active" : "")"
                   asp-controller="Home" asp-action="AboutAccount">
                    <i class="bi bi-person-lock nav-icon" aria-hidden="true"></i>
                    <span class="nav-label">Account & Login</span>
                </a>

                <a class="nav-button @(ViewContext.HttpContext.Request.Path == "/about/support" ? "active" : "")"
                   asp-controller="Home" asp-action="AboutSupport">
                    <i class="bi bi-life-preserver nav-icon" aria-hidden="true"></i>
                    <span class="nav-label">Support</span>
                </a>

                <a class="nav-button @(ViewContext.HttpContext.Request.Path == "/about/policies" ? "active" : "")"
                   asp-controller="Home" asp-action="AboutPolicies">
                    <i class="bi bi-journal-text nav-icon" aria-hidden="true"></i>
                    <span class="nav-label">Libraries Policy</span>
                </a>

            </aside>

            <!-- Main Content -->
            <main class="main-content">

                <h2>About the Service</h2>
                <p>
                    This service provides online access to a digital library containing books,
                    documents, and educational resources. Access to the platform is restricted
                    to registered users.
                </p>

                <h2>Account Registration</h2>
                <p>
                    Register on the website with your name, email address and phone number.
                    A librarian reviews each new account before it can be used.
                </p>

                <ul>
                    <li>Complete the registration form</li>
                    <li>A librarian approves the account</li>
                    <li>You can sign in once it has been approved</li>
                </ul>

                <h2>Login Process</h2>
                <p>
                    Sign in with your password, using either the email address or the phone number
                    registered on your account.
                </p>

                <h2>Forgotten Password</h2>
                <p>
                    Use the Forgot Password link on the sign-in page. Enter your registered email
                    address and the library emails you a link for choosing a new password.
                </p>

                <ul>
                    <li>The link can be used once</li>
                    <li>It stops working as soon as your password changes</li>
                    <li>If nothing arrives, check your spam folder</li>
                </ul>

                <h2>Security Information</h2>
                <ul>
                    <li>Passwords are stored only as salted hashes, never in readable form</li>
                    <li>Reset links are single-use and expire</li>
                    <li>Requesting a reset never reveals whether an address is registered</li>
                    <li>Accounts must be approved by a librarian before first use</li>
                </ul>

                <h2>Account Management</h2>
                <p>
                    Account preferences and basic information can be managed within the account
                    settings section.
                </p>

                <h2>Support</h2>
                <p>
                    For issues related to registration or login:
                </p>

                <ul>
                    <li>See the Support page on the website</li>
                    <li>Or ask staff at the circulation desk, who can reset your password</li>
                </ul>

            </main>

        </div>
    </div>

    <script>
                                            function navigateTo(section) {
                                                if (section === 'General') {
                                                    window.location.href = '@Url.Action("Index", "FAQ")';
                                                } else if (section === 'Support') {
                                                    window.location.href = '@Url.Action("Support", "FAQ")';
                                                } else if (section === 'Libraries') {
                                                    window.location.href = '@Url.Action("LibrariesPolicy", "FAQ")';
                                                }
                                            }
    </script>

</body>

</html>
