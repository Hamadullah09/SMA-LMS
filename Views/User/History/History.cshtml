@using System.Globalization
@model Library_Management_system.Models.HistoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My borrowing";
    ViewData["FullWidth"] = true;   // the design system supplies its own measure

    string Money(decimal amount) =>
        $"{Model.Currency} {amount.ToString("0.00", CultureInfo.InvariantCulture)}";

    var owes = Model.EstimatedFine > 0;
}

@*
    Borrowing history.

    Rebuilt on the student design system. Two things changed beyond styling:

    * the fine figures are real. The page printed "Late return fee ($1/day)" and dollar amounts
      while the library charges PKR 20.00 a day — the rate came from a constant in the controller
      rather than from LibraryPolicy, so a student was told they owed a twentieth of the truth in
      the wrong currency. Rate and currency now come from policy.

    * what you owe is stated up front rather than hidden behind a dropdown. It was in a panel
      that had to be clicked to open, which is the wrong place for the one number a student
      might have to act on.
*@

<div class="sma-history">

    <header class="sma-history__head">
        <div>
            <h1 class="sma-history__title">My borrowing</h1>
            <p class="sma-history__sub">Everything you have borrowed, returned, or still have out.</p>
        </div>

        @* Returning used to require opening a loan first. The button is on the page now, and on
           each book still out below, because a student who came here to give a book back should
           not have to hunt for how. *@
        @if (Model.OnHoldCount > 0)
        {
            <a class="sma-history__return-cta" href="/kiosk?mode=Return">
                <span aria-hidden="true">&#8617;</span>
                Return a book
            </a>
        }
    </header>

    @* ---------------- summary ---------------- *@
    <section class="sma-history__stats" aria-label="Borrowing summary">
        <div class="sma-stat">
            <span class="sma-stat__value">@Model.TotalCount</span>
            <span class="sma-stat__label">Total borrowed</span>
        </div>
        <div class="sma-stat">
            <span class="sma-stat__value">@Model.OnHoldCount</span>
            <span class="sma-stat__label">Still out</span>
        </div>
        <div class="sma-stat">
            <span class="sma-stat__value">@Model.ReturnedCount</span>
            <span class="sma-stat__label">Returned</span>
        </div>

        @* The one number that may require action, so it is on the page rather than behind a click. *@
        <div class="sma-stat @(owes ? "is-owed" : "is-clear")">
            <span class="sma-stat__value">@Money(Model.EstimatedFine)</span>
            <span class="sma-stat__label">@(owes ? "Outstanding fines" : "Nothing owed")</span>
        </div>
    </section>

    <p class="sma-history__terms">
        Overdue books are charged at <strong>@Money(Model.FinePerDay) per day</strong>, per book.
        Fines are settled at the circulation desk.
        <a asp-controller="Home" asp-action="AboutPolicies">Borrowing terms</a>
    </p>

    @* ---------------- list ---------------- *@
    @if (Model.Items.Any())
    {
        <div class="sma-history__list">
            @foreach (var item in Model.Items)
            {
                var yearText = item.Year > 0 ? item.Year.ToString(CultureInfo.InvariantCulture) : "—";
                var borrowDateText = item.BorrowDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
                var dueDateText = item.DueDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
                var returnDateText = item.ReturnDate.HasValue
                    ? item.ReturnDate.Value.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                    : "—";
                var cover = string.IsNullOrWhiteSpace(item.ImageUrl)
                    ? Url.Content("~/images/User/Book/book2.png")
                    : Url.Content(item.ImageUrl);

                <article class="sma-history__item">
                    <a class="sma-history__cover" asp-controller="Home" asp-action="BookDetail"
                       asp-route-id="@item.BookId" tabindex="-1" aria-hidden="true">
                        <img src="@cover" alt="" loading="lazy" />
                    </a>

                    <div class="sma-history__body">
                        <h2 class="sma-history__book">
                            <a asp-controller="Home" asp-action="BookDetail" asp-route-id="@item.BookId">@item.Title</a>
                        </h2>
                        <p class="sma-history__author">@item.Author</p>
                        <p class="sma-history__meta">
                            <span class="sma-mono">@item.BookCode</span> &middot; @yearText
                        </p>

                        @* Status carries a word as well as colour (section 111). *@
                        <span class="sma-history__status is-@item.Status">@item.StatusLabel</span>
                    </div>

                    <dl class="sma-history__dates">
                        <div><dt>Borrowed</dt><dd>@borrowDateText</dd></div>
                        <div><dt>Due</dt><dd>@dueDateText</dd></div>
                        <div><dt>Returned</dt><dd>@returnDateText</dd></div>
                    </dl>

                    <div class="sma-history__money">
                        @if (item.LateDays > 0)
                        {
                            <span class="sma-history__late">@item.LateDays day@(item.LateDays == 1 ? "" : "s") late</span>
                        }

                        @if (item.FineAmount > 0)
                        {
                            <span class="sma-history__fine @(item.FinePaid ? "is-paid" : "is-due")">
                                @Money(item.FineAmount)
                                <small>@(item.FinePaid ? "paid" : "to pay")</small>
                            </span>

                            @if (item.FinePaid && item.FinePaidDate.HasValue)
                            {
                                <span class="sma-history__paid-on">
                                    on @item.FinePaidDate.Value.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                                </span>
                            }
                        }
                        else if (item.LateDays == 0)
                        {
                            <span class="sma-history__fine is-none">No fine</span>
                        }
                    </div>

                    @* Still out, so offer the way to give it back right here. *@
                    @if (item.Status is "borrowing" or "overdue")
                    {
                        <a class="sma-history__return" href="/kiosk?mode=Return">Return</a>
                    }
                </article>
            }
        </div>
    }
    else
    {
        <div class="sma-history__empty">
            <div class="sma-history__empty-glyph" aria-hidden="true">📚</div>
            <h2 class="sma-history__empty-title">You have not borrowed anything yet</h2>
            <p>When you borrow a book it appears here with its due date, so you can see what to bring back and when.</p>
            <a class="sma-browse__empty-action" asp-controller="Home" asp-action="Book">Browse the catalogue</a>
        </div>
    }
</div>
