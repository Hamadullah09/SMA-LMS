@model Library_Management_system.Models.Portal.CatalogueViewModel
@{
    ViewData["Title"] = "Catalogue";
    Layout = null;
    string PageUrl(int p) =>
        $"/catalogue?q={Uri.EscapeDataString(Model.Query ?? "")}&category={Uri.EscapeDataString(Model.Category ?? "")}&availableOnly={Model.AvailableOnly}&sort={Model.Sort}&page={p}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Catalogue — SMA Library</title>
    <link rel="stylesheet" href="~/css/sma-design-system.css" asp-append-version="true" />
</head>
<body class="sma">
<header class="sma-topbar">
    <div style="display:flex;align-items:center;gap:var(--sma-space-3)">
        <img src="/images/brand/sma-mark.png" alt="" aria-hidden="true"
             width="38" height="38" class="sma-sidebar__brand-mark" />
        <div>
            <div style="font-weight:700">SMA Library</div>
            <div class="sma-small sma-muted">Catalogue</div>
        </div>
    </div>
    <nav style="display:flex;gap:var(--sma-space-2)" aria-label="Primary">
        <a class="sma-btn sma-btn--ghost" href="/portal">My Library</a>
        <a class="sma-btn sma-btn--ghost" href="/">Home</a>
    </nav>
</header>

<main class="sma-main">
    <h1>Find a book</h1>

    @* ---- Search and filters (section 11) ---- *@
    <form method="get" class="sma-card" style="margin-bottom:var(--sma-space-6)">
        <div class="sma-card__body">
            <div class="sma-field">
                <label class="sma-label" for="q">Search by title, author, ISBN or category</label>
                <input class="sma-input" id="q" name="q" value="@Model.Query"
                       placeholder="e.g. Clean Code, Herbert, 9780132350884" autocomplete="off" />
            </div>

            <div class="sma-grid sma-grid--3">
                <div class="sma-field" style="margin-bottom:0">
                    <label class="sma-label" for="category">Category</label>
                    <select class="sma-select" id="category" name="category">
                        <option value="">All categories</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c" selected="@(c == Model.Category)">@c</option>
                        }
                    </select>
                </div>

                <div class="sma-field" style="margin-bottom:0">
                    <label class="sma-label" for="sort">Sort by</label>
                    <select class="sma-select" id="sort" name="sort">
                        <option value="title" selected="@(Model.Sort == "title")">Title</option>
                        <option value="author" selected="@(Model.Sort == "author")">Author</option>
                        <option value="year" selected="@(Model.Sort == "year")">Newest first</option>
                        <option value="availability" selected="@(Model.Sort == "availability")">Most available</option>
                    </select>
                </div>

                <div class="sma-field" style="margin-bottom:0;display:flex;align-items:flex-end">
                    <label style="display:flex;align-items:center;gap:var(--sma-space-2);cursor:pointer">
                        <input type="checkbox" name="availableOnly" value="true" checked="@Model.AvailableOnly" />
                        <span>Only show books I can borrow now</span>
                    </label>
                </div>
            </div>

            <div style="margin-top:var(--sma-space-4);display:flex;gap:var(--sma-space-3)">
                <button type="submit" class="sma-btn sma-btn--primary">Search</button>
                @if (Model.HasFilters)
                {
                    <a class="sma-btn sma-btn--ghost" href="/catalogue">Clear filters</a>
                }
            </div>
        </div>
    </form>

    <p class="sma-muted" role="status">
        @if (Model.TotalCount == 0)
        {
            <text>No books found.</text>
        }
        else
        {
            <text>@Model.TotalCount book@(Model.TotalCount == 1 ? "" : "s") found — page @Model.Page of @Model.TotalPages</text>
        }
    </p>

    @if (Model.Results.Count == 0)
    {
        <div class="sma-card">
            <div class="sma-card__body">
                <div class="sma-empty">
                    <div class="sma-empty__icon" aria-hidden="true">▤</div>
                    <div class="sma-empty__title">
                        @(Model.HasFilters ? "Nothing matched your search" : "The catalogue is empty")
                    </div>
                    <p class="sma-empty__body">
                        @if (Model.HasFilters)
                        {
                            <text>
                                Try a shorter search term, a different category, or clear the
                                "only show books I can borrow now" filter — the book may be on loan
                                rather than absent.
                            </text>
                        }
                        else
                        {
                            <text>No books have been added yet. A librarian can add them from the admin area.</text>
                        }
                    </p>
                    @if (Model.HasFilters)
                    {
                        <a class="sma-btn sma-btn--primary" href="/catalogue">Clear filters</a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="sma-grid sma-grid--3">
            @foreach (var card in Model.Results)
            {
                <article class="sma-card" style="display:flex;flex-direction:column">
                    @if (!string.IsNullOrWhiteSpace(card.CoverImage))
                    {
                        @* Lazy-loaded: a 12-card grid should not block on images (section 110). *@
                        <img src="@card.CoverImage" alt="Cover of @card.Title" loading="lazy"
                             style="width:100%;height:190px;object-fit:cover;border-radius:var(--sma-radius) var(--sma-radius) 0 0" />
                    }
                    <div class="sma-card__body" style="display:flex;flex-direction:column;flex:1">
                        <div class="sma-small sma-muted">@card.CategoryName</div>
                        <h3 style="margin:var(--sma-space-1) 0">@card.Title</h3>
                        <div class="sma-muted" style="margin-bottom:var(--sma-space-3)">@card.Author</div>

                        <div style="margin-bottom:var(--sma-space-3)">
                            @if (card.IsAvailable)
                            {
                                <span class="sma-badge sma-badge--success">✓ @card.AvailabilityText</span>
                            }
                            else
                            {
                                <span class="sma-badge sma-badge--warning">▲ @card.AvailabilityText</span>
                            }
                        </div>

                        <div class="sma-small sma-muted" style="margin-top:auto;padding-top:var(--sma-space-3)">
                            @(card.LocationSummary ?? "See copies for shelf location")
                        </div>

                        <a class="sma-btn sma-btn--primary" style="margin-top:var(--sma-space-3)"
                           href="/catalogue/@card.BookId">View book</a>
                    </div>
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav style="display:flex;gap:var(--sma-space-3);justify-content:center;margin-top:var(--sma-space-6)"
                 aria-label="Catalogue pages">
                @if (Model.Page > 1)
                {
                    <a class="sma-btn sma-btn--ghost" href="@PageUrl(Model.Page - 1)">← Previous</a>
                }
                <span class="sma-btn sma-btn--ghost" aria-current="page">Page @Model.Page of @Model.TotalPages</span>
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="sma-btn sma-btn--ghost" href="@PageUrl(Model.Page + 1)">Next →</a>
                }
            </nav>
        }
    }
</main>
</body>
</html>
