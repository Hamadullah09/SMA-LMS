@using Library_Management_system.Application.Assistant
@{
    ViewData["Title"] = "Library Assistant";
    Layout = null;
    var question = ViewBag.Question as string;
    var answer = ViewBag.Answer as AssistantAnswer;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Library Assistant — SMA Library</title>
    <link rel="stylesheet" href="~/css/sma-design-system.css" asp-append-version="true" />
</head>
<body class="sma">
<header class="sma-topbar">
    <div style="display:flex;align-items:center;gap:var(--sma-space-3)">
        <img src="/images/brand/sma-mark.png" alt="" aria-hidden="true"
             width="38" height="38" class="sma-sidebar__brand-mark" />
        <div>
            <div style="font-weight:700">SMA Library</div>
            <div class="sma-small sma-muted">Assistant</div>
        </div>
    </div>
    <nav style="display:flex;gap:var(--sma-space-2)" aria-label="Primary">
        <a class="sma-btn sma-btn--ghost" href="/catalogue">Catalogue</a>
        <a class="sma-btn sma-btn--ghost" href="/portal">My Library</a>
    </nav>
</header>

<main class="sma-main" style="max-width:820px">
    <h1>Ask the library</h1>
    <p class="sma-muted">
        I answer from the live catalogue and your own record — so if I say a book is on the shelf,
        it is. If I do not know something, I will tell you rather than guess.
    </p>

    <form method="get" class="sma-card" style="margin-bottom:var(--sma-space-5)">
        <div class="sma-card__body">
            <div class="sma-field" style="margin-bottom:0">
                <label class="sma-label" for="q">Your question</label>
                <input class="sma-input" id="q" name="q" value="@question" autofocus autocomplete="off"
                       placeholder="Where is Clean Code?" />
            </div>
            <button type="submit" class="sma-btn sma-btn--primary" style="margin-top:var(--sma-space-4)">Ask</button>
        </div>
    </form>

    @if (answer is not null)
    {
        <div class="sma-card" style="margin-bottom:var(--sma-space-5)">
            <div class="sma-card__body">
                <div class="sma-small sma-subtle" style="margin-bottom:var(--sma-space-2)">You asked</div>
                <p style="margin-bottom:var(--sma-space-5)"><strong>@question</strong></p>

                <div class="sma-small sma-subtle" style="margin-bottom:var(--sma-space-2)">Answer</div>
                @* Answers may contain a list of loans, one per line. *@
                <p style="white-space:pre-line;font-size:var(--sma-text-lg);margin-bottom:var(--sma-space-4)">@answer.Text</p>

                @if (answer.Links.Count > 0)
                {
                    <div style="display:flex;flex-wrap:wrap;gap:var(--sma-space-3)">
                        @foreach (var link in answer.Links)
                        {
                            <a class="sma-btn sma-btn--ghost" href="@link.Url">@link.Label</a>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="sma-card">
        <div class="sma-card__header"><h2 class="sma-card__title">Things you can ask</h2></div>
        <div class="sma-card__body">
            <div style="display:flex;flex-wrap:wrap;gap:var(--sma-space-2)">
                @foreach (var example in new[]
                {
                    "Where is Clean Code?",
                    "Do you have Dune?",
                    "Can I borrow Foundation?",
                    "What books do I have?",
                    "Do I owe any fines?",
                    "How many books can I borrow?",
                    "What happens if I return a book late?"
                })
                {
                    <a class="sma-btn sma-btn--ghost sma-small" href="/assistant?q=@Uri.EscapeDataString(example)">@example</a>
                }
            </div>
        </div>
    </div>
</main>
</body>
</html>
