@model List<Library_Management_system.Domain.Entities.RfidReader>
@using Library_Management_system.Domain.Enums
@{
    ViewData["Title"] = "Reader Health";
    ViewBag.SmaActive = "readers";
    ViewBag.SmaSubtitle = "Live status of every RFID reader.";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";

    // Glyph + word, never colour alone (specification section 111).
    (string Glyph, string Css, string Label) Present(RfidReaderStatus status) => status switch
    {
        RfidReaderStatus.Online     => ("●", "sma-badge--success", "Online"),
        RfidReaderStatus.Connecting => ("◐", "sma-badge--info",    "Connecting"),
        RfidReaderStatus.Error      => ("▲", "sma-badge--warning", "Error"),
        RfidReaderStatus.Disabled   => ("■", "sma-badge--neutral", "Disabled"),
        _                           => ("○", "sma-badge--danger",  "Offline")
    };

    string Ago(DateTime? utc)
    {
        if (utc is null) return "never";
        var span = DateTime.UtcNow - utc.Value;
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s ago";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return utc.Value.ToString("dd MMM yyyy");
    }
}

@if (Model.Count == 0)
{
    @* Meaningful empty state with a next action (specification section 104). *@
    <div class="sma-card">
        <div class="sma-card__body">
            <div class="sma-empty">
                <div class="sma-empty__icon" aria-hidden="true">📡</div>
                <div class="sma-empty__title">No RFID readers registered yet</div>
                <p class="sma-empty__body">
                    Once a reader is registered its connection status, last heartbeat and most recent
                    scan appear here. Until then, circulation runs through the manual workflow, which
                    applies exactly the same borrowing rules.
                </p>
                <a class="sma-btn sma-btn--primary" href="/desk/manual">Go to manual issue</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="sma-grid sma-grid--3">
        @foreach (var reader in Model)
        {
            var state = Present(reader.Status);
            <div class="sma-card">
                <div class="sma-card__body">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:var(--sma-space-3)">
                        <div>
                            <h3 style="margin-bottom:var(--sma-space-1)">@reader.Name</h3>
                            <div class="sma-small sma-muted">@(reader.Model ?? "Unknown model") • @reader.Purpose</div>
                        </div>
                        <span class="sma-badge @state.Css">@state.Glyph @state.Label</span>
                    </div>

                    <dl style="margin:var(--sma-space-4) 0 0;display:grid;grid-template-columns:auto 1fr;gap:var(--sma-space-2) var(--sma-space-4)">
                        <dt class="sma-small sma-muted">Last heartbeat</dt>
                        <dd class="sma-small" style="margin:0">@Ago(reader.LastHeartbeatUtc)</dd>

                        <dt class="sma-small sma-muted">Last scan</dt>
                        <dd class="sma-small" style="margin:0">@Ago(reader.LastScanUtc)</dd>

                        <dt class="sma-small sma-muted">Location</dt>
                        <dd class="sma-small" style="margin:0">@(reader.LocationDescription ?? "Not recorded")</dd>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(reader.LastError))
                    {
                        <div class="sma-alert sma-alert--warning" style="margin-top:var(--sma-space-4);margin-bottom:0">
                            <span class="sma-alert__icon" aria-hidden="true">▲</span>
                            <div class="sma-small">@reader.LastError</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
