@*
    SMA LMS browser metadata — one partial so every layout stays in step and no page
    can be left carrying the previous project's favicon (specification section 4).
*@
<link rel="icon" href="~/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="~/images/brand/sma-icon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="~/images/brand/sma-icon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="~/images/brand/sma-icon-180.png" />
<link rel="manifest" href="~/site.webmanifest" />
<meta name="application-name" content="SMA Library" />
<meta name="apple-mobile-web-app-title" content="SMA Library" />
<meta property="og:site_name" content="SMA Library" />
<meta property="og:title" content="SMA Library" />
<meta property="og:type" content="website" />
<meta property="og:image" content="~/images/brand/sma-logo.png" />
