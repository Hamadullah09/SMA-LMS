@page
@model ResetPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Choose a new password";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_SmaFavicon" />
    <title>@ViewData["Title"] - SMA Library</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Login/login.css" asp-append-version="true" />
    @* SMA design tokens + Bootstrap theming. Must load last so it wins. *@
    <link rel="stylesheet" href="~/css/sma-theme-bridge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/users/reset-password.css" asp-append-version="true" />
</head>

<body>
    <div class="container">
        <div class="card reset-card">

            <div class="right">

                <div class="auth-logo">
                    <img src="~/images/brand/sma-logo.png" alt="SMA Library" />
                </div>

                <div class="btn-login-student reset-banner">
                    Choose a new password for @Model.Input?.Email
                </div>

                <form method="post" class="reset-form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    @* Carried through the post so the token is verified against the same account
                       the emailed link was issued for. *@
                    <input asp-for="Input.Email" type="hidden" />
                    <input asp-for="Input.Code" type="hidden" />

                    <div class="input-group">
                        <div class="icon-password">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <input asp-for="Input.Password" type="password" class="password"
                               placeholder="New password" autocomplete="new-password"
                               aria-required="true" required />
                        <span class="toggle-password" role="button" tabindex="0" data-target="#Input_Password"
                              aria-label="Show password">
                            <i class="bi bi-eye-slash" id="togglePassword1"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>

                    <div class="input-group">
                        <div class="icon-password">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <input asp-for="Input.ConfirmPassword" type="password" class="confirm-password"
                               placeholder="Confirm new password" autocomplete="new-password"
                               aria-required="true" required />
                        <span class="toggle-password" role="button" tabindex="0" data-target="#Input_ConfirmPassword"
                              aria-label="Show password">
                            <i class="bi bi-eye-slash" id="togglePassword2"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

                    <button type="submit" class="btn-signin">
                        <span class="btn-text">Set new password</span>
                    </button>
                </form>

                <div class="links reset-links">
                    <div class="forgot">
                        <a asp-page="./Login">Back to login</a>
                    </div>
                    <p>
                        Link expired?
                        <a asp-page="./ForgotPassword">Request a new one</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/admin/login.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>

</html>
