@page
@model ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot your password?";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_SmaFavicon" />
    <title>@ViewData["Title"] - SMA Library</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Login/login.css" asp-append-version="true" />
    @* SMA design tokens + Bootstrap theming. Must load last so it wins. *@
    <link rel="stylesheet" href="~/css/sma-theme-bridge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/users/reset-password.css" asp-append-version="true" />
</head>

<body>
    <div class="container">
        <div class="card reset-card">

            <div class="right">

                <div class="auth-logo">
                    <img src="~/images/brand/sma-logo.png" alt="SMA Library" />
                </div>

                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="text-danger" role="alert" style="margin-bottom:1rem">@errorMessage</div>
                }

                <section class="reset-guide" aria-label="Password reset guide">
                    <p class="reset-guide__title">
                        <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                        How to reset your password
                    </p>
                    <ol class="reset-guide__steps">
                        <li>Enter the email address registered on your library account.</li>
                        <li>We email you a link — check your inbox, and your spam folder.</li>
                        <li>Open the link and choose a new password.</li>
                        <li>The link works once. If it expires, request another.</li>
                    </ol>
                </section>

                <form method="post" class="reset-form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="input-group">
                        <div class="icon-email">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <input asp-for="Input.Email" type="email" placeholder="Email address"
                               autocomplete="email" aria-required="true" required />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>

                    <button type="submit" class="btn-signin">
                        <span class="btn-text">Email me a reset link</span>
                    </button>
                </form>

                <div class="links reset-links">
                    <div class="forgot">
                        <a asp-page="./Login">Back to login</a>
                    </div>
                    <p>
                        Don’t have an account?
                        <a asp-page="./Register">Sign up</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/admin/login.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>

</html>
