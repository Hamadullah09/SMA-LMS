@page
@model ForgotPasswordConfirmation
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password Confirmation";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_SmaFavicon" />
    <title>@ViewData["Title"] - SMA Library</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Login/login.css" asp-append-version="true" />
    @* SMA design tokens + Bootstrap theming. Must load last so it wins. *@
    <link rel="stylesheet" href="~/css/sma-theme-bridge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/users/reset-password.css" asp-append-version="true" />
</head>

<body>
    <div class="container">
        <div class="card reset-card">

            <div class="right">

                
                <div class="auth-logo">
                    <img src="~/images/brand/sma-logo.png" alt="SMA Library" />
                </div>
<div class="btn-login-student reset-banner">
                    Reset link sent.
                </div>

                @* Worded so it says the same thing whether or not the address is registered —
                   the page must not become a way to test which emails have accounts. *@
                <section class="reset-result-card" aria-label="Forgot password confirmation">
                    <div class="reset-result-icon reset-result-icon--info">
                        <i class="bi bi-envelope-check" aria-hidden="true"></i>
                    </div>
                    <h3>Check your email</h3>
                    <p>
                        If that address has a library account, we have emailed a link for choosing a
                        new password. It can be used once. If nothing arrives within a few minutes,
                        check your spam folder.
                    </p>
                </section>

                <a asp-page="./Login" class="btn-signin reset-action-link">
                    <span class="btn-text">Back to login</span>
                </a>

                <div class="links reset-links">
                    <p>
                        Wrong address, or nothing arrived?
                        <a asp-page="./ForgotPassword">Try again</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
