<?xml version="1.0" encoding="utf-8"?>
<!--
    Publish generates a web.config when the project has none, and its defaults are wrong for
    this application on shared hosting in two ways.

    startupTimeLimit is 120 seconds by default. Program.cs runs Database.MigrateAsync() before
    app.Run(), so the very first start against an empty database has to create the whole schema
    over a shared SQL host before it can serve anything. Exceeding the limit makes the module
    kill the process and return an empty 503 - no error page, nothing in the browser to say why.

    stdout logging is off by default, which leaves nothing to read when startup does fail. It is
    on here deliberately: this is the only visibility into a failure that happens before any of
    the application's own logging exists. Turn it off once the site is healthy - it grows without
    bound and every request pays for the write.

    processPath and arguments are injected by publish; they are not repeated here.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"
                  startupTimeLimit="600"
                  requestTimeout="00:10:00">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- The full startup exception in the browser instead of a bare 503. Worth having
               while the deployment is being brought up; remove it once it is serving. -->
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="true" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
